{
  "name": "bluvi-web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "design": "node scripts/serve-static.mjs design 4300",
    "test:visual": "playwright test -c tests/visual/playwright.visual.config.ts",
    "test:visual:update": "playwright test -c tests/visual/playwright.visual.config.ts --update-snapshots",
    "test:lighthouse": "next build && lhci autorun --config=lighthouserc.json",
    "parity": "node scripts/parity.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sentry/nextjs": "^11.6.0",
    "@tanstack/react-query": "^5.104.0",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "firebase": "^12.19.0",
    "gifenc": "^1.0.3",
    "maplibre-gl": "^6.12.0",
    "next": "^16.3.6",
    "qs": "^6.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "supercluster": "^9.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
