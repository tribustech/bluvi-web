# CMS base URL, INCLUDING the /api suffix. Server-side (proxy, server components, auth routes).
CMS_URL=http://localhost:1337/api
# Same URL, readable by the browser, for public GETs that can go straight to Cloudflare.
NEXT_PUBLIC_CMS_URL=http://localhost:1337/api
# Canonical site origin (sitemap, robots, OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with the CMS (WEB_REVALIDATE_SECRET there). The CMS POSTs purged cache tags to /api/revalidate.
REVALIDATE_SECRET=change-me

# Google Identity Services (code flow, popup). Client id = the CMS's GOOGLE_CLIENT_ID (web client).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login JS SDK
NEXT_PUBLIC_FACEBOOK_APP_ID=
# Sign in with Apple JS — the Services ID (CMS patch P3 must accept it as an audience)
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# QA only: enables POST /api/auth/local (users-permissions local provider). Never set in production.
ENABLE_LOCAL_AUTH=

# Firebase web app config (same Firebase project as the mobile app) + the chat collection environment.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_ENV=local

# Local QA account for contract + e2e tests (users-permissions local provider). Never commit values.
CONTRACT_EMAIL=
CONTRACT_PASSWORD=

# e2e only: a full-access API token of the LOCAL Strapi (:1337). Tests use it to seed and then delete
# throwaway rows (tests/e2e/notificari.spec.ts «c9 real»). Never a staging/prod token; never commit it.
E2E_STRAPI_API_TOKEN=

# --- Launch / telemetry (M8). Names only; values live in Vercel. See docs/RUNBOOK.md §2. ---
# Search indexing: `1` ONLY on the production launch deployment (read at build time). Unset → robots
# disallows all and every response carries X-Robots-Tag: noindex, nofollow.
SITE_INDEXABLE=
# GA4 measurement id of the web stream. Production only; unset → no gtag script, no _ga cookie.
# Runs only after the visitor's «Analiză» consent.
NEXT_PUBLIC_GA4_ID=
# `1` lets GA run outside production with debug_mode (DebugView). Never on Production.
NEXT_PUBLIC_ANALYTICS_DEBUG=
# Sentry. Unset DSNs → Sentry never initialises. Reports only from production / preview / staging.
# Server / edge DSN (independent of consent).
SENTRY_DSN=
# Browser DSN (loaded only after the «Monitorizarea erorilor» consent).
NEXT_PUBLIC_SENTRY_DSN=
# production | preview | staging; unset → Vercel's VERCEL_ENV.
SENTRY_ENVIRONMENT=
# Build only: source-map upload. All three or none. The token is a secret: Vercel only, never here.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# `1` serves /dev/* (kit, templates, Sentry crash page) in a production build. Never on Production.
ENABLE_DEV_KIT=
# Optional local override: path to the public-waters SQLite dataset (default: the bundled data/public-waters file).
PUBLIC_WATERS_DB=
