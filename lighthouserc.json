{
  "ci": {
    "collect": {
      "startServerCommand": "next start -p 3200",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/balti",
        "http://localhost:3200/balti/s84u55lo4n9z0emngozttt6e",
        "http://localhost:3200/balti/harta",
        "http://localhost:3200/concursuri",
        "http://localhost:3200/concursuri/uxxie29m6820wrpdv45w0m7q",
        "http://localhost:3200/concursuri/uxxie29m6820wrpdv45w0m7q/clasament",
        "http://localhost:3200/ape-publice",
        "http://localhost:3200/stiri",
        "http://localhost:3200/stiri/e75ur4eyp4q1itaia7zotwxn",
        "http://localhost:3200/partide",
        "http://localhost:3200/partide/pyz9mcgitrsqyclj5kan6wkz"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75, "disabled": false },
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "desktop": {
      "paths": ["/", "/balti", "/balti/[id]", "/concursuri"],
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["warn", { "minScore": 1 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
